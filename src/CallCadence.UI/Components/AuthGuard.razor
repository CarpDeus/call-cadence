@*
    Functional authentication guard built on the standard Blazor auth stack.
    Wrap protected markup in <AuthGuard> (optionally with Roles="Admin") to render it
    only for authenticated (and, when specified, appropriately-roled) users.
    Unauthenticated users are redirected to the login page; authorized-but-wrong-role
    users see the NotAuthorized content.
*@
<AuthorizeView Roles="@Roles" Context="authContext">
    <Authorized>
        @{
            NotifyAuthenticated();
        }
        @ChildContent
    </Authorized>
    <NotAuthorized>
        @if (NotAuthorized is not null)
        {
            @NotAuthorized
        }
        else
        {
            <RedirectToLogin />
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    /// <summary>
    /// The protected content to render once authentication (and any required role) is confirmed.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Optional comma-separated list of roles required to view the content (e.g. "Admin").
    /// When empty, any authenticated user is allowed.
    /// </summary>
    [Parameter]
    public string? Roles { get; set; }

    /// <summary>
    /// Optional content shown when the user is not authorized. Defaults to redirecting
    /// unauthenticated users to the login page.
    /// </summary>
    [Parameter]
    public RenderFragment? NotAuthorized { get; set; }

    /// <summary>
    /// Optional callback invoked once after authentication (and any required role) is
    /// confirmed, allowing protected pages to run initialization logic only when authorized.
    /// </summary>
    [Parameter]
    public EventCallback OnAuthenticated { get; set; }

    private bool _authenticatedNotified;

    private void NotifyAuthenticated()
    {
        if (_authenticatedNotified || !OnAuthenticated.HasDelegate)
        {
            return;
        }

        _authenticatedNotified = true;
        _ = OnAuthenticated.InvokeAsync();
    }
}
