@inject CallCadence.UI.Services.UserSessionState Session
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration

<MudNavMenu>
    <MudNavLink Href="/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
    <MudNavLink Href="/api-editing" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Api">API Editing</MudNavLink>
    @if (Session.IsAdmin)
    {
        <MudNavGroup Title="Settings" Icon="@Icons.Material.Filled.Settings" Expanded="@IsSettingsExpanded">
            <MudNavLink Href="/settings/users" Match="NavLinkMatch.Prefix">Users</MudNavLink>
            <MudNavLink Href="/settings/sso-configuration" Match="NavLinkMatch.Prefix">SSO Configuration</MudNavLink>
        </MudNavGroup>
        @if (HangfireDashboardUrl is not null)
        {
            <MudNavLink Href="@HangfireDashboardUrl" Target="_blank" Icon="@Icons.Material.Filled.Work">Hangfire Dashboard</MudNavLink>
        }
    }
</MudNavMenu>

@code {
    private bool IsSettingsExpanded => NavigationManager.Uri.Contains("/settings", StringComparison.OrdinalIgnoreCase);

    // Opens the API's Hangfire Dashboard in a new tab. The current JWT is passed to the
    // API's /hangfire/login handshake, which validates it, confirms the Admin role, and
    // issues a short-lived cookie before redirecting to the dashboard.
    private string? HangfireDashboardUrl
    {
        get
        {
            var token = Session.Token;
            if (string.IsNullOrWhiteSpace(token))
            {
                return null;
            }

            var apiBaseUrl = Configuration["Api:BaseUrl"];
            if (string.IsNullOrWhiteSpace(apiBaseUrl))
            {
                return null;
            }

            return $"{apiBaseUrl.TrimEnd('/')}/hangfire/login?access_token={Uri.EscapeDataString(token)}";
        }
    }
}
