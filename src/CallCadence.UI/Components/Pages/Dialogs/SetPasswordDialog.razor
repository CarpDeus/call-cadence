@using CallCadence.Models.Auth
@using CallCadence.UI.Services
@inject CallCadenceApiClient ApiClient

<MudDialog>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
        }
        <MudStack Spacing="2">
            <MudTextField Label="New Password"
                          @bind-Value="_request.Password"
                          InputType="InputType.Password"
                          HelperText="12+ characters with upper, lower, digit, and symbol." />
            <MudTextField Label="Confirm Password"
                          @bind-Value="_confirmPassword"
                          InputType="InputType.Password"
                          HelperText="Re-enter the password to confirm." />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="_isSaving" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSaving" OnClick="SubmitAsync">
            Set Password
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public UserSummaryResponse User { get; set; } = default!;

    private readonly SetUserPasswordRequest _request = new();
    private string _confirmPassword = string.Empty;
    private bool _isSaving;
    private string? _error;

    private async Task SubmitAsync()
    {
        if (!DialogValidation.ValidatePassword(_request.Password))
        {
            _error = "Password must be 12+ characters with upper, lower, digit, and symbol.";
            return;
        }

        if (_request.Password != _confirmPassword)
        {
            _error = "Passwords do not match.";
            return;
        }

        _isSaving = true;
        _error = null;

        try
        {
            await ApiClient.SetUserPasswordAsync(User.Id, _request);
            MudDialog.Close(DialogResult.Ok($"Password updated for '{User.Email}'."));
        }
        catch (Exception ex)
        {
            _error = ApiClient.GetErrorMessage(ex, $"Unable to update password for '{User.Email}'.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
