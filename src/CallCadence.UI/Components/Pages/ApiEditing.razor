@page "/api-editing"
@attribute [Authorize]
@rendermode InteractiveServer
@using CallCadence.Application.ApiCall
@using CallCadence.UI.Services
@inject CallCadenceApiClient ApiClient
@inject UserSessionState Session
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>API Editing</PageTitle>

<AuthGuard>
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
    }

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
        <MudTextField T="string"
                      Label="Title"
                      Value="_titleFilter"
                      ValueChanged="OnTitleFilterChanged"
                      DebounceInterval="400"
                      Clearable="true"
                      Immediate="true"
                      Style="min-width: 220px;" />

        <MudSelect T="TriStateFilterOption"
                   Label="Enabled"
                   Value="_enabledFilter"
                   ValueChanged="OnEnabledFilterChanged"
                   Style="min-width: 140px;">
            <MudSelectItem Value="TriStateFilterOption.All">All</MudSelectItem>
            <MudSelectItem Value="TriStateFilterOption.Yes">Yes</MudSelectItem>
            <MudSelectItem Value="TriStateFilterOption.No">No</MudSelectItem>
        </MudSelect>

        <MudSelect T="TriStateFilterOption"
                   Label="Schedule Defined"
                   Value="_scheduleFilter"
                   ValueChanged="OnScheduleFilterChanged"
                   Style="min-width: 160px;">
            <MudSelectItem Value="TriStateFilterOption.All">All</MudSelectItem>
            <MudSelectItem Value="TriStateFilterOption.Yes">Yes</MudSelectItem>
            <MudSelectItem Value="TriStateFilterOption.No">No</MudSelectItem>
        </MudSelect>
    </MudStack>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/api-editing/new">Add API</MudButton>
</MudStack>

@if (_filtersReady)
{
<MudTable T="ApiCallListItemDto"
          @ref="_table"
          ServerData="LoadApiCallsAsync"
          Hover="true"
          Height="400px"
          FixedHeader="true"
          FixedFooter="true"
          Dense="true">
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel T="ApiCallListItemDto" SortLabel="title" InitialDirection="SortDirection.Ascending">Title</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="ApiCallListItemDto" SortLabel="enabled">Enabled</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="ApiCallListItemDto" SortLabel="hasSchedule">Schedule Defined</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="ApiCallListItemDto" SortLabel="nextScheduledCall">Next Scheduled Call</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="ApiCallListItemDto" SortLabel="lastSuccessAt">Last Success</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="ApiCallListItemDto" SortLabel="lastErrorAt">Last Error</MudTableSortLabel>
        </MudTh>
        <MudTh>Edit</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Title">@context.Title</MudTd>
        <MudTd DataLabel="Enabled">@FormatFlag(context.IsActive)</MudTd>
        <MudTd DataLabel="Schedule Defined">@FormatFlag(context.HasSchedule)</MudTd>
        <MudTd DataLabel="Next Scheduled Call">@FormatNextScheduledCall(context.NextScheduledCall)</MudTd>
        <MudTd DataLabel="Last Success">@FormatSince(context.LastSuccessAt)</MudTd>
        <MudTd DataLabel="Last Error">@FormatSince(context.LastErrorAt)</MudTd>
        <MudTd DataLabel="Edit">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@($"/api-editing/{context.Id}")">Edit</MudButton>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudTable>
}

</AuthGuard>

@code {
    private MudTable<ApiCallListItemDto>? _table;
    private string? _errorMessage;
    private TriStateFilterOption _enabledFilter = TriStateFilterOption.Yes;
    private TriStateFilterOption _scheduleFilter = TriStateFilterOption.All;
    private string _titleFilter = string.Empty;
    private bool _filtersReady;

    private const string EnabledFilterStorageKey = "api-editing-filter";
    private const string ScheduleFilterStorageKey = "api-editing-schedule-filter";
    private const string TitleFilterStorageKey = "api-editing-title-filter";

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        try
        {
            var savedEnabled = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", EnabledFilterStorageKey);
            if (savedEnabled is not null && Enum.TryParse<TriStateFilterOption>(savedEnabled, out var parsedEnabled))
            {
                _enabledFilter = parsedEnabled;
            }

            var savedSchedule = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", ScheduleFilterStorageKey);
            if (savedSchedule is not null && Enum.TryParse<TriStateFilterOption>(savedSchedule, out var parsedSchedule))
            {
                _scheduleFilter = parsedSchedule;
            }

            var savedTitle = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", TitleFilterStorageKey);
            if (savedTitle is not null)
            {
                _titleFilter = savedTitle;
            }
        }
        catch
        {
            // localStorage may be unavailable; use default
        }
        finally
        {
            // Render the table only after filters are restored so the initial
            // ServerData load runs once with the correct filter values.
            _filtersReady = true;
        }
    }

    private async Task<TableData<ApiCallListItemDto>> LoadApiCallsAsync(TableState state, CancellationToken cancellationToken)
    {
        if (!Session.IsAuthenticated)
        {
            return new TableData<ApiCallListItemDto>
            {
                Items = Array.Empty<ApiCallListItemDto>(),
                TotalItems = 0
            };
        }

        try
        {
            var response = await ApiClient.GetApiCallListAsync(new ApiCallListRequest
            {
                PageNumber = state.Page + 1,
                PageSize = state.PageSize,
                SortBy = string.IsNullOrWhiteSpace(state.SortLabel) ? "title" : state.SortLabel,
                SortDescending = state.SortDirection == SortDirection.Descending,
                Enabled = _enabledFilter switch
                {
                    TriStateFilterOption.Yes => true,
                    TriStateFilterOption.No => false,
                    _ => null
                },
                HasSchedule = _scheduleFilter switch
                {
                    TriStateFilterOption.Yes => true,
                    TriStateFilterOption.No => false,
                    _ => null
                },
                Title = string.IsNullOrWhiteSpace(_titleFilter) ? null : _titleFilter.Trim()
            }, cancellationToken);

            _errorMessage = null;

            return new TableData<ApiCallListItemDto>
            {
                Items = response.Items,
                TotalItems = response.Paging.TotalItems
            };
        }
        catch (HttpRequestException ex) when (ex.StatusCode is System.Net.HttpStatusCode.Unauthorized
            or System.Net.HttpStatusCode.Forbidden)
        {
            await ApiClient.ClearSessionAsync();
            NavigationManager.NavigateTo("/");
            return new TableData<ApiCallListItemDto>
            {
                Items = Array.Empty<ApiCallListItemDto>(),
                TotalItems = 0
            };
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _errorMessage = ApiClient.GetErrorMessage(ex, "Unable to load API definitions.");
            return new TableData<ApiCallListItemDto>
            {
                Items = Array.Empty<ApiCallListItemDto>(),
                TotalItems = 0
            };
        }
    }

    private async Task OnEnabledFilterChanged(TriStateFilterOption value)
    {
        _enabledFilter = value;

        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", EnabledFilterStorageKey, value.ToString());
        }
        catch
        {
            // localStorage may be unavailable; filter change still applied
        }

        await ReloadTableAsync();
    }

    private async Task OnScheduleFilterChanged(TriStateFilterOption value)
    {
        _scheduleFilter = value;

        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", ScheduleFilterStorageKey, value.ToString());
        }
        catch
        {
            // localStorage may be unavailable; filter change still applied
        }

        await ReloadTableAsync();
    }

    private async Task OnTitleFilterChanged(string? value)
    {
        _titleFilter = value ?? string.Empty;

        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", TitleFilterStorageKey, _titleFilter);
        }
        catch
        {
            // localStorage may be unavailable; filter change still applied
        }

        await ReloadTableAsync();
    }

    private async Task ReloadTableAsync()
    {
        if (_table is not null)
        {
            _table.NavigateTo(0);
            await _table.ReloadServerData();
        }
    }

    private static string FormatFlag(bool value) => value ? "Yes" : "No";

    private static string FormatNextScheduledCall(DateTime? timestamp)
    {
        return timestamp.HasValue
            ? timestamp.Value.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'")
            : "Not scheduled";
    }

    private static string FormatSince(DateTime? timestamp)
    {
        if (!timestamp.HasValue)
        {
            return "Never";
        }

        var elapsed = DateTime.UtcNow - timestamp.Value;
        if (elapsed.TotalSeconds < 60)
        {
            return $"{Math.Max(0, (int)elapsed.TotalSeconds)}s ago";
        }

        if (elapsed.TotalMinutes < 60)
        {
            return $"{(int)elapsed.TotalMinutes}m ago";
        }

        if (elapsed.TotalHours < 24)
        {
            return $"{(int)elapsed.TotalHours}h ago";
        }

        return $"{(int)elapsed.TotalDays}d ago";
    }

    private enum TriStateFilterOption
    {
        All,
        Yes,
        No
    }
}
